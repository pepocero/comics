# Copia este archivo como ".env" para desarrollo local (no se sube a Git).
# Vite solo expone variables que empiezan por VITE_.
#
# IMPORTANTE: en .env el símbolo # inicia un comentario. Las URLs de MEGA
# deben ir ENTRE COMILLAS o la clave (después de #) se borrará al cargar.
#
# Tres cuentas / carpetas MEGA (enlace completo: carpeta + clave tras #):
VITE_MEGA_FOLDER_URL_1="https://mega.nz/folder/TU_HANDLE_1#TU_CLAVE_1"
VITE_MEGA_FOLDER_URL_2="https://mega.nz/folder/TU_HANDLE_2#TU_CLAVE_2"
VITE_MEGA_FOLDER_URL_3="https://mega.nz/folder/TU_HANDLE_3#TU_CLAVE_3"
#
# Opcional: nombres en el selector
# VITE_MEGA_SOURCE_LABEL_1=Biblioteca A
# VITE_MEGA_SOURCE_LABEL_2=Biblioteca B
# VITE_MEGA_SOURCE_LABEL_3=Biblioteca C
#
# Una sola URL (solo si no usas _1 … _3):
# VITE_MEGA_FOLDER_URL="https://mega.nz/folder/…#…"
#
# Cloudflare Pages: pega el enlace completo en el valor de cada variable;
# allí no suele haber el problema del # del .env local.
#
# Build / PWA (opcional): si no usas Cloudflare, puedes fijar un id de build visible en la app.
# En Cloudflare Pages el SHA se toma solo de CF_PAGES_COMMIT_SHA al compilar.
# VITE_BUILD_ID=mi-release-1
