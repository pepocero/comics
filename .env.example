# Copia este archivo como ".env" para desarrollo local (no se sube a Git).
# Vite solo expone variables que empiezan por VITE_.
#
# URL pública del sitio (sin barra final), para la miniatura al compartir en WhatsApp / redes:
# p. ej. https://tu-dominio.com o https://tu-proyecto.pages.dev
# Sin esto, og:image queda como ruta relativa y muchos crawlers no muestran la imagen.
# VITE_SITE_ORIGIN=https://ejemplo.com
#
# IMPORTANTE: en .env el símbolo # inicia un comentario. Las URLs de MEGA
# deben ir ENTRE COMILLAS o la clave (después de #) se borrará al cargar.
#
# Hasta ocho fuentes: carpetas MEGA (enlace con #) o enlace compartido Terabox (https://…/s/…).
VITE_MEGA_FOLDER_URL_1="https://mega.nz/folder/TU_HANDLE_1#TU_CLAVE_1"
VITE_MEGA_FOLDER_URL_2="https://mega.nz/folder/TU_HANDLE_2#TU_CLAVE_2"
VITE_MEGA_FOLDER_URL_3="https://mega.nz/folder/TU_HANDLE_3#TU_CLAVE_3"
VITE_MEGA_FOLDER_URL_4="https://mega.nz/folder/TU_HANDLE_4#TU_CLAVE_4"
VITE_MEGA_FOLDER_URL_5="https://mega.nz/folder/TU_HANDLE_5#TU_CLAVE_5"
VITE_MEGA_FOLDER_URL_6="https://mega.nz/folder/TU_HANDLE_6#TU_CLAVE_6"
VITE_MEGA_FOLDER_URL_7="https://mega.nz/folder/TU_HANDLE_7#TU_CLAVE_7"
# Ejemplo Terabox (url8): recurso compartido, no es MEGA
# VITE_MEGA_FOLDER_URL_8="https://1024terabox.com/s/TU_CODIGO"
#
# Opcional: nombres en el selector
# VITE_MEGA_SOURCE_LABEL_1=Biblioteca A
# VITE_MEGA_SOURCE_LABEL_2=Biblioteca B
# VITE_MEGA_SOURCE_LABEL_3=Biblioteca C
# VITE_MEGA_SOURCE_LABEL_4=Biblioteca D
# VITE_MEGA_SOURCE_LABEL_5=Biblioteca E
# VITE_MEGA_SOURCE_LABEL_6=Biblioteca F
# VITE_MEGA_SOURCE_LABEL_7=Biblioteca G
# VITE_MEGA_SOURCE_LABEL_8=Mi Terabox
#
# Opcional: resolver Terabox (POST JSON { "url", "link" }). Vacío = /api/terabox-proxy (Vite → terabox.page en dev; en Pages, functions/api/terabox-proxy.ts).
# Con secreto TERABOX_COOKIE en Cloudflare Pages, el mismo host sirve listado estilo muxfox y /api/terabox-dl.
# VITE_TERABOX_RESOLVER_URL=https://terabox.page/api/proxy
#
# Solo desarrollo (Vite, no se inyecta al bundle): si terabox.page devuelve 502, apunta el proxy a otro origen.
# TERABOX_DEV_PROXY_TARGET=https://tu-worker.workers.dev
# Worker muxfox: ruta POST en /. Si usas terabox.page, deja la ruta por defecto o pon explícito:
# TERABOX_DEV_PROXY_PATH=/api/proxy
# TERABOX_DEV_PROXY_PATH=/
#
# Una sola URL (solo si no usas _1 … _8):
# VITE_MEGA_FOLDER_URL="https://mega.nz/folder/…#…"
#
# Build / PWA (opcional): id de build visible en la app si lo necesitas en el hosting.
# VITE_BUILD_ID=mi-release-1
